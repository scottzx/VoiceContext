{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voicecontext.invalid/recording-ai-actions/common.schema.json",
  "title": "C00 draft shared primitives; not a released storage format",
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "opaqueID": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recordingID",
        "revision",
        "sha256"
      ],
      "properties": {
        "recordingID": {
          "$ref": "#/$defs/uuid"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "sourceRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceKind",
        "sourceID",
        "startSample",
        "endSample"
      ],
      "properties": {
        "sourceKind": {
          "enum": [
            "audio_chunk",
            "imported_asset"
          ]
        },
        "sourceID": {
          "$ref": "#/$defs/uuid"
        },
        "startSample": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "endSample": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        }
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "segmentIDs"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/source"
        },
        "segmentIDs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/uuid"
          }
        },
        "startSample": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "endSample": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "excerpt": {
          "type": "string",
          "minLength": 1
        }
      },
      "dependentRequired": {
        "startSample": [
          "endSample"
        ],
        "endSample": [
          "startSample"
        ]
      }
    }
  }
}
