        },
        "state": {
          "enum": [
            "deleting",
            "completed"
          ]
        },
        "objects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/deletionObject"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "completed"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "objects": {
                "items": {
                  "properties": {
                    "state": {
                      "enum": [
                        "deleted",
                        "rebuilt",
                        "kept"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/transcriptEvidence"
    },
    {
      "$ref": "#/$defs/preflight"
    },
    {
      "$ref": "#/$defs/candidate"
    },
    {
      "$ref": "#/$defs/adoption"
    },
    {
      "$ref": "#/$defs/history"
